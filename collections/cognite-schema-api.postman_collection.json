        {
          "id": "911dd797-dd2e-4eeb-a9b9-3bd28db1affe",
          "name": "Get Instance schema.",
          "request": {
            "name": "Get Instance schema.",
            "description": {
              "content": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nFor View centric schema, `viewSpace`, `viewExternalId`, `viewVersion` need to be specified while `withInstanceSpace`, `isConnectionDefinition`, `instanceType` are optional . For Data Model centric schema, `dataModelSpace`, `dataModelExternalId`, `dataModelVersion`, `type` need to be specified and `relationshipFromType` is optional. For Both scenarios `conflictMode` is required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transformations",
                "schema",
                "instances"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "conflictMode",
                  "value": "<string>",
                  "description": "conflict mode of the transformation.\n One of the following conflictMode types can be provided:\n `upsert`, `delete`\n "
                },
                {
                  "disabled": false,
                  "key": "viewSpace",
                  "value": "<string>",
                  "description": "Space of the View. Not required if `isConnectionDefinition` is true. Relevant for View centric schema."
                },
                {
                  "disabled": false,
                  "key": "viewExternalId",
                  "value": "<string>",
                  "description": "External id of the View. Not required if `isConnectionDefinition` is true. Relevant for View centric schema."
                },
                {
                  "disabled": false,
                  "key": "viewVersion",
                  "value": "<string>",
                  "description": "Version of the View. Not required if `isConnectionDefinition` is true. Relevant for View centric schema."
                },
                {
                  "disabled": false,
                  "key": "instanceType",
                  "value": "<string>",
                  "description": "Instance type to deal with"
                },
                {
                  "disabled": false,
                  "key": "withInstanceSpace",
                  "value": "<boolean>",
                  "description": "Is instance space set at the transformation config or not"
                },
                {
                  "disabled": false,
                  "key": "isConnectionDefinition",
                  "value": "<boolean>",
                  "description": "If the edge is a connection definition or not"
                },
                {
                  "disabled": false,
                  "key": "dataModelSpace",
                  "value": "<string>",
                  "description": "Space of the Data Model. Relevant for Data Model centric schema."
                },
                {
                  "disabled": false,
                  "key": "dataModelExternalId",
                  "value": "<string>",
                  "description": "External id of the Data Model. Relevant for Data Model centric schema."
                },
                {
                  "disabled": false,
                  "key": "dataModelVersion",
                  "value": "<string>",
                  "description": "Version of the Data Model. Relevant for Data Model centric schema."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "External id of the View in the Data model. Relevant for Data Model centric schema."
                },
                {
                  "disabled": false,
                  "key": "relationshipFromType",
                  "value": "<string>",
                  "description": "Property Identifier of Connection Definition in `type`. Relevant for Data Model centric schema."
                }
              ],
              "variable": [
                {
                  "description": "The CDF cluster to connect to (This can only be one of api,az-tyo-gp-001,az-eastus-1,az-power-no-northeurope,westeurope-1,asia-northeast1-1,gc-dsm-gp-001)",
                  "type": "any",
                  "value": "{{cluster}}",
                  "key": "cluster"
                },
                {
                  "description": "The CDF project name.",
                  "type": "any",
                  "value": "{{project}}",
                  "key": "project"
                }
              ]
            },

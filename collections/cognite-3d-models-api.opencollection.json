{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping 3D Models API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "3D Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List 3D models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/models",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results. In general, if a response contains a `nextCursor`\nproperty, it means that there may be more results, and you should pass that value as the\n`cursor` parameter in the next request.\n\nNote that the cursor may or may not be encrypted, but either way, it is not intended to be\ndecoded. Its internal structure is not a part of the public API, and may change without\nnotice. You should treat it as an opaque string and not attempt to craft your own cursors.\n"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned. The maximum results returned by the server is 1000 even if you specify a higher limit."
              },
              {
                "name": "includeRevisionInfo",
                "value": "",
                "type": "query",
                "description": "If true, return latest revision info as part of response"
              },
              {
                "name": "published",
                "value": "",
                "type": "query",
                "description": "Filter based on whether or not it has published revisions."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `threedAcl:READ`\n\nRetrieves a list of all models in a project. This operation supports pagination. You can filter out all models without a published revision."
        },
        {
          "info": {
            "name": "Create 3D models",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/models",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `threedAcl:CREATE`\n"
        },
        {
          "info": {
            "name": "Update 3D models",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/models/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `threedAcl:UPDATE`\n"
        },
        {
          "info": {
            "name": "Delete 3D models",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/models/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `threedAcl:DELETE`\n"
        },
        {
          "info": {
            "name": "Retrieve a 3D model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/models/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `threedAcl:READ`\n"
        }
      ]
    }
  ],
  "bundled": true
}
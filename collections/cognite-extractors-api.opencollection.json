{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Extractors API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Extractors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Extractors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors"
          },
          "docs": "List all available extractors."
        },
        {
          "info": {
            "name": "Retrieve Extractors",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve extractors by external ID, optionally ignoring unknown IDs."
        },
        {
          "info": {
            "name": "List releases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/releases",
            "params": [
              {
                "name": "externalId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List releases for all extractors, or optionally for a single extractor. Results are sorted in descending version order."
        },
        {
          "info": {
            "name": "Retrieve Releases",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/releases/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve releases by extractor external ID and version, optionally ignoring unknown IDs."
        },
        {
          "info": {
            "name": "List Source Systems",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/sources"
          },
          "docs": "List source systems. Source systems represent sources that extractors may read from. They are tied to extractors through Solutions."
        },
        {
          "info": {
            "name": "Retrieve Source Systems",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/sources/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve source systems. Source systems represent sources that extractors may read from. They are tied to extractors through Solutions."
        },
        {
          "info": {
            "name": "List Solutions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/solutions"
          },
          "docs": "List solutions. Solutions connect sources to extractors, documenting how a specific extractor might be used to connect to a source system."
        },
        {
          "info": {
            "name": "Retrieve Solutions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/solutions/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve solutions by external ID. Solutions connect sources to extractors, documenting how a specific extractor might be used to connect to a source system."
        },
        {
          "info": {
            "name": "Get Config Schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/extractors/schemas/:extractor/:version",
            "params": [
              {
                "name": "extractor",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the configuration schema for the specified extractor and release version. The configuration schema is a [JSON Schema](https://json-schema.org/) file."
        }
      ]
    }
  ],
  "bundled": true
}
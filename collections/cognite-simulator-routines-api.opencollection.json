{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Simulator Routines API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Simulator Routines",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Simulator Routine",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/routines",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a simulator routine."
        },
        {
          "info": {
            "name": "Filter Simulator Routines",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/routines/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of simulator routines that match the given criteria."
        },
        {
          "info": {
            "name": "Delete Simulator Routine",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/routines/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a simulator routine. This will also delete all associated simulator resources (e.g. revisions, runs, data)."
        },
        {
          "info": {
            "name": "Aggregate Simulator Routines",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/routines/aggregate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Calculate aggregates for simulator routines, considering the optional filter specification."
        },
        {
          "info": {
            "name": "Create Simulator Routine Revision",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/routines/revisions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The total size of the request body can be a maximum of 50.00 KB.\n\nWhen creating a simulator routine revision, be mindful of the following:\n\n- The amount and size of the inputs you provide to the simulator routine.\n- The size of the outputs you expect from the simulator routine.\n\nThe total size of the data sent by a simulator connector cannot exceed 100.00 KB per simulation run."
        },
        {
          "info": {
            "name": "Filter Simulator Routine Revisions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/routines/revisions/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of simulator routine revisions that match the given criteria."
        },
        {
          "info": {
            "name": "Retrieve Simulator Routine Revisions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/routines/revisions/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve one or more simulator routine revisions by IDs or external IDs."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Statistics API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Statistics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve project-wide statistics and limits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/models/statistics"
          },
          "docs": "\n\n> **Required capabilities:** `dataModelsAcl:READ`\n\nReturns statistics and limits for data modeling resources across the project. Use this endpoint to monitor your overall data modeling usage and available capacity."
        },
        {
          "info": {
            "name": "Retrieve statistics by space",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/models/statistics/spaces"
          },
          "docs": "\n\n> **Required capabilities:** `dataModelsAcl:READ`\n\nReturns statistics for data modeling resources grouped by each space in the project."
        },
        {
          "info": {
            "name": "Retrieve statistics by space for specific space-ids",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/models/statistics/spaces/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `dataModelsAcl:READ`\n\nReturns statistics for data modeling resources grouped by space for a specified list of spaces."
        }
      ]
    }
  ],
  "bundled": true
}
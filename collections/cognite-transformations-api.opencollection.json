{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Transformations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transformations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List transformations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned. The maximum is 1000, default limit is 100."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results."
              },
              {
                "name": "includePublic",
                "value": "",
                "type": "query",
                "description": "Whether public transformations should be included in the results. The default is true."
              },
              {
                "name": "withJobDetails",
                "value": "",
                "type": "query",
                "description": "Whether transformations should contain information about jobs. The default is true."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nList transformations. Use nextCursor to paginate through the results."
        },
        {
          "info": {
            "name": "Create transformations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n\nCreate a maximum of 1000 transformations per request."
        },
        {
          "info": {
            "name": "Retrieve transformations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nRetrieve a maximum of 1000 transformations by ids and externalIds per request."
        },
        {
          "info": {
            "name": "Filter transformations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/filter",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nFilter transformations. Use nextCursor to paginate through the results."
        },
        {
          "info": {
            "name": "Delete transformations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n\nDelete a maximum of 1000 transformations by ids and externalIds per request."
        },
        {
          "info": {
            "name": "Update transformations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n\nUpdate the attributes of transformations, maximum 1000 per request."
        },
        {
          "info": {
            "name": "Run a transformation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/run",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n"
        },
        {
          "info": {
            "name": "Cancel a transformation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/cancel",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n"
        }
      ]
    }
  ],
  "bundled": true
}
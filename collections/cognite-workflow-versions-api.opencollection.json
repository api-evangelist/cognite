{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Workflow versions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflow versions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Filter workflow versions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows/versions/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:READ`\n\nList workflow versions matching a given filter."
        },
        {
          "info": {
            "name": "Create or update a workflow version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows/versions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:WRITE`\n\nCreate or update a workflow version. Limited to a single workflow version per request."
        },
        {
          "info": {
            "name": "Retrieve a workflow version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows/:workflowExternalId/versions/:version",
            "params": [
              {
                "name": "workflowExternalId",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:READ`\n\nRetrieve a version of a given workflow."
        },
        {
          "info": {
            "name": "Delete workflow versions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows/versions/delete",
            "params": [
              {
                "name": "ignoreUnknownIds",
                "value": "",
                "type": "query",
                "description": "If `true`, ignore unknown version ids. If `false`, a `404 Not Found` error is returned and none of the versions are deleted if any of the version ids are unknown."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:WRITE`\n\nDelete specific versions of one or more workflows."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Simulator Integrations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Simulator Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Filter Simulator Integrations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/integrations/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of simulator integrations that match the given criteria."
        },
        {
          "info": {
            "name": "Delete Simulator Integrations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/integrations/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a simulator integration. This will also delete all associated simulator resources (e.g. routines, runs)."
        }
      ]
    }
  ],
  "bundled": true
}
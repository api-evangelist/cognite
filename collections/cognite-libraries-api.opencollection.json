{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Libraries API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Libraries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List libraries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/libraries",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results. In general, if a response contains a `nextCursor`\nproperty, it means that there may be more results, and you should pass that value as the\n`cursor` parameter in the next request.\n\nNote that the cursor may or may not be encrypted, but either way, it is not intended to be\ndecoded. Its internal structure is not a part of the public API, and may change without\nnotice. You should treat it as an opaque string and not attempt to craft your own cursors.\n"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:READ`\n\nList all libraries defined in the current project."
        },
        {
          "info": {
            "name": "Create libraries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/libraries",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:WRITE`\n\nCreate libraries."
        },
        {
          "info": {
            "name": "Get a library with symbols",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/libraries/:libraryId",
            "params": [
              {
                "name": "libraryId",
                "value": "",
                "type": "path",
                "description": "External ID of a library"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:READ`\n\nReturns a single library with all its symbols and geometries."
        },
        {
          "info": {
            "name": "Copy library",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/libraries/:libraryId/copy",
            "params": [
              {
                "name": "libraryId",
                "value": "",
                "type": "path",
                "description": "External ID of a library"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:WRITE`\n\nCreates a new library by copying an existing library, including all its symbols and geometries."
        },
        {
          "info": {
            "name": "Retrieve libraries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/libraries/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:READ`\n\nRetrieve up to 100 libraries by specifying their IDs."
        },
        {
          "info": {
            "name": "Delete libraries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/libraries/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:WRITE`\n\nDelete up to 100 libraries by specifying their IDs."
        },
        {
          "info": {
            "name": "Update libraries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/libraries/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:WRITE`\n\nUpdate the properties of a set of libraries."
        }
      ]
    }
  ],
  "bundled": true
}
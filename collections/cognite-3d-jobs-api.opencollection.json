{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping 3D Jobs API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "3D Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a job using 3D source data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/jobs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datamodels:READ(cdf_cdm, cdf_cdm_3d)` `datamodelinstances:WRITE`\n\nCreates a job to be run using a 3D source. Currently supported in data-modeling projects only.\nThe user defines a dms instance they want the job to run against, and defines it as the source of the job.\nInside the job you define the space a job will exist in, and its external id, this is not populated into dms.\nThe job external id should be created by the client, and be unique.\nIf the job result is s"
        },
        {
          "info": {
            "name": "List jobs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/jobs/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datamodels:READ(cdf_cdm, cdf_cdm_3d)` `datamodelinstances:READ`\n\nList jobs for your project."
        },
        {
          "info": {
            "name": "Delete jobs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/jobs/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datamodels:READ(cdf_cdm, cdf_cdm_3d)` `datamodelinstances:WRITE`\n\nDelete jobs in your project. The job instance results won't be deleted by this operation."
        },
        {
          "info": {
            "name": "List Job Results",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/job/results/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List the results of a job"
        },
        {
          "info": {
            "name": "Update Job Result Rejections",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/job/result/rejections",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Job Instance Results have internal unique keys you can reject\nto allow yourself to filter away job results items you are no longer\ninterested in"
        },
        {
          "info": {
            "name": "List Job Result Rejections",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/3d/job/result/rejections/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "A list of internal keys that are to be considered rejected"
        }
      ]
    }
  ],
  "bundled": true
}
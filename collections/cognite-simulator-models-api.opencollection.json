{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Simulator Models API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Simulator Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Simulator Model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a simulator model."
        },
        {
          "info": {
            "name": "Filter Simulator Models",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of simulator models that match the given criteria."
        },
        {
          "info": {
            "name": "Aggregate Simulator Models",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/aggregate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Calculate aggregates for simulator models, considering the optional filter specification."
        },
        {
          "info": {
            "name": "Delete Simulator Model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a simulator model. This will also delete all associated simulator resources (e.g. revisions, routines, runs)."
        },
        {
          "info": {
            "name": "Update Simulator Model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a simulator model."
        },
        {
          "info": {
            "name": "Retrieve Simulator Model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve a simulator model by ID or external ID."
        },
        {
          "info": {
            "name": "Create Simulator Model Revision",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/revisions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a simulator model revision."
        },
        {
          "info": {
            "name": "Filter Simulator Model Revisions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/revisions/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of simulator model revisions that match the given criteria."
        },
        {
          "info": {
            "name": "Retrieve Simulator Model Revisions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/models/revisions/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve one or more simulator model revisions by IDs or external IDs."
        }
      ]
    }
  ],
  "bundled": true
}
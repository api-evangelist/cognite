{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Document parsing API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Document parsing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Write Results to Data Models (INTERNAL)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/context/documentparser/jobs/write",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Write results to data models.\n"
        }
      ]
    }
  ],
  "bundled": true
}
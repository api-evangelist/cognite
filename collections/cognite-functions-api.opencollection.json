{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Functions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Functions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List functions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nList functions."
        },
        {
          "info": {
            "name": "Create functions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:WRITE`\n\nYou can only create one function per request."
        },
        {
          "info": {
            "name": "Functions limits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/limits"
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nService limits for the associated project."
        },
        {
          "info": {
            "name": "Filter functions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use advanced filtering options to find functions."
        },
        {
          "info": {
            "name": "Delete functions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:WRITE`\n\nDelete functions. You can delete a maximum of 10 functions per request. Function source files stored in the Files API must be deleted separately."
        },
        {
          "info": {
            "name": "Retrieve a function by its id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/:functionId",
            "params": [
              {
                "name": "functionId",
                "value": "",
                "type": "path",
                "description": "The function id."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nRetrieve a function by its id. If you want to retrieve functions by names, use Retrieve functions instead."
        },
        {
          "info": {
            "name": "Retrieve functions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nRetrieve functions by ids."
        },
        {
          "info": {
            "name": "Get activation status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/status"
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nGet activation status"
        },
        {
          "info": {
            "name": "Activate Functions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/status"
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:WRITE`\n\nActivate Cognite Functions. This will create the necessary backend infrastructure for Cognite Functions."
        }
      ]
    }
  ],
  "bundled": true
}
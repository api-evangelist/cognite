{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Units API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Units",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve units by external IDs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/units/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves one or more units by external ID. The response returns the units in the same order as in the request."
        },
        {
          "info": {
            "name": "Retrieve unit by external ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/units/:externalId",
            "params": [
              {
                "name": "externalId",
                "value": "",
                "type": "path",
                "description": "External ID of the unit"
              }
            ]
          },
          "docs": "Retrieve a single unit by its external ID."
        },
        {
          "info": {
            "name": "List all units",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/units"
          },
          "docs": "List all units."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Workflows API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:READ`\n\nList workflows in the project."
        },
        {
          "info": {
            "name": "Create or update a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:WRITE`\n\nCreate or update a workflow. Limited to a single workflow per request."
        },
        {
          "info": {
            "name": "Delete workflows",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows/delete",
            "params": [
              {
                "name": "ignoreUnknownIds",
                "value": "",
                "type": "query",
                "description": "If `true`, ignore unknown workflow ids. If `false`, a `404 Not Found` error is returned and none of the workflows are deleted if any of the workflow ids are unknown."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:WRITE`\n\nDelete workflows, including all associated workflow versions."
        },
        {
          "info": {
            "name": "Retrieve a workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/workflows/:workflowExternalId",
            "params": [
              {
                "name": "workflowExternalId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `workflowOrchestrationACL:READ`\n\nRetrieve a workflow by its external id."
        }
      ]
    }
  ],
  "bundled": true
}
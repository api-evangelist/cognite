{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Transformation Schedules API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transformation Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/schedules",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned. The maximum is 1000, default limit is 100."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results."
              },
              {
                "name": "includePublic",
                "value": "",
                "type": "query",
                "description": "Whether public transformations should be included in the results. The default is true."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nList all transformation schedules. Use nextCursor to paginate through the results."
        },
        {
          "info": {
            "name": "Schedule transformations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/schedules",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n\nSchedule transformations with the specified configurations."
        },
        {
          "info": {
            "name": "Retrieve schedules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/schedules/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nRetrieve transformation schedules by transformation IDs or external IDs."
        },
        {
          "info": {
            "name": "Unschedule transformations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/schedules/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n\nUnschedule transformations by IDs or externalIds."
        },
        {
          "info": {
            "name": "Update schedules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/schedules/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n"
        }
      ]
    }
  ],
  "bundled": true
}
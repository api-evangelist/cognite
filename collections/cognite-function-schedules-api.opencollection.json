{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Function schedules API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Function schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/schedules",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nList function schedules in project."
        },
        {
          "info": {
            "name": "Create schedules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/schedules",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:WRITE`\n\nCreate function schedules. Function schedules trigger asynchronous calls with specific input data, based on a cron expression that determines when these triggers should be fired. Use e.g. http://www.cronmaker.com to be guided on how to generate a cron expression. One of `FunctionId` or `FunctionExternalId` (deprecated) must be set (but not both). When creating a schedule with a session, i.e. with a `nonce`, `FunctionId` must be used. The `nonc"
        },
        {
          "info": {
            "name": "Filter function schedules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/schedules/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use advanced filtering options to find function schedules.  At most one of `FunctionId` or `FunctionExternalId` can be specified."
        },
        {
          "info": {
            "name": "Retrieve a function schedule by its id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/schedules/:scheduleId",
            "params": [
              {
                "name": "scheduleId",
                "value": "",
                "type": "path",
                "description": "The function schedule id."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nRetrieve a function schedule by its id."
        },
        {
          "info": {
            "name": "Retrieve schedules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/schedules/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nRetrieve function schedules by schedule ids."
        },
        {
          "info": {
            "name": "Delete schedules",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/schedules/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:WRITE`\n\nDelete function schedules."
        },
        {
          "info": {
            "name": "Retrieve function input data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/functions/schedules/:scheduleId/input_data",
            "params": [
              {
                "name": "scheduleId",
                "value": "",
                "type": "path",
                "description": "The function schedule id."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `functionsAcl:READ`\n\nRetrieve the input data to the associated function."
        }
      ]
    }
  ],
  "bundled": true
}
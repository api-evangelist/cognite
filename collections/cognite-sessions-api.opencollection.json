{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Sessions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sessions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/sessions",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "If given, only sessions with the given status are returned.\n"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor to use for paging through results."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Return up to this many results. Maximum is 1000. Default is 25."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `sessionsAcl:LIST`\n\nList all sessions in the current project."
        },
        {
          "info": {
            "name": "Create sessions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `sessionsAcl:CREATE`\n\nCreate sessions"
        },
        {
          "info": {
            "name": "Retrieve sessions with given IDs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/sessions/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `sessionsAcl:LIST`\n\nRetrieves sessions with given IDs. The request will fail if any of the IDs does not belong to an existing session."
        },
        {
          "info": {
            "name": "Revoke sessions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/sessions/revoke",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `sessionsAcl:DELETE`\n\nRevoke access to a session. Revocation is idempotent.\nRevocation of a session may in some cases take up to 1 hour to take effect.\n"
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Transformation Notifications API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transformation Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List notification subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/notifications",
            "params": [
              {
                "name": "transformationId",
                "value": "",
                "type": "query",
                "description": "List only notifications for the specified transformation. The transformation is identified by ID."
              },
              {
                "name": "transformationExternalId",
                "value": "",
                "type": "query",
                "description": "List only notifications for the specified transformation. The transformation is identified by external ID."
              },
              {
                "name": "destination",
                "value": "",
                "type": "query",
                "description": "Filter by notification destination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned. The maximum is 1000, default limit is 100."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n"
        },
        {
          "info": {
            "name": "Subscribe for notifications",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/notifications",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n\nSubscribe for notifications on the transformation errors."
        },
        {
          "info": {
            "name": "Delete notification subscriptions by notification ID",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/notifications/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:WRITE`\n\nDeletes the specified notification subscriptions on the transformation. Requests to delete non-existing subscriptions do nothing, but do not throw an error."
        }
      ]
    }
  ],
  "bundled": true
}
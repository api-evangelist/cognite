{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Geometries API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Geometries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List geometries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/geometries",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results. In general, if a response contains a `nextCursor`\nproperty, it means that there may be more results, and you should pass that value as the\n`cursor` parameter in the next request.\n\nNote that the cursor may or may not be encrypted, but either way, it is not intended to be\ndecoded. Its internal structure is not a part of the public API, and may change without\nnotice. You should treat it as an opaque string and not attempt to craft your own cursors.\n"
              },
              {
                "name": "symbolId",
                "value": "",
                "type": "query",
                "description": "Retrieve items related to the symbol"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:READ`\n\nList all geometries (also called variants in documentation) defined in the current project."
        },
        {
          "info": {
            "name": "Create geometries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/geometries",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:WRITE`\n\nCreate geometries."
        },
        {
          "info": {
            "name": "Retrieve geometries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/geometries/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:READ`\n\nRetrieve up to 100 geometries by specifying their IDs."
        },
        {
          "info": {
            "name": "Delete geometries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/geometries/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:WRITE`\n\nDelete up to 100 geometries by specifying their IDs."
        },
        {
          "info": {
            "name": "Update geometries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/geometries/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:WRITE`\n\nUpdate the properties of a set of geometries"
        }
      ]
    }
  ],
  "bundled": true
}
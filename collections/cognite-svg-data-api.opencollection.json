{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping SVG Data API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SVG Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get SVG data by diagramId",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/svg-data/diagram/:diagramId",
            "params": [
              {
                "name": "diagramId",
                "value": "",
                "type": "path",
                "description": "External ID of a diagram"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:READ` `dataModelInstancesAcl:READ`\n\nGet the SVG data of a file by externalId of a diagram."
        },
        {
          "info": {
            "name": "Get SVG data by file reference",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/diagram-parsing/svg-data/file/:fileSpace/:fileExternalId/:pageNumber",
            "params": [
              {
                "name": "fileSpace",
                "value": "",
                "type": "path",
                "description": "A DMS space where the files reside"
              },
              {
                "name": "fileExternalId",
                "value": "",
                "type": "path",
                "description": "Retrieve data related to a file"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "path",
                "description": "The file's page number"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `diagramParsingAcl:READ` `dataModelInstancesAcl:READ`\n\nGet the SVG data of a file by file instanceId and pageNumber."
        }
      ]
    }
  ],
  "bundled": true
}
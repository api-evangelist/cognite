{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Transformation Jobs API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transformation Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/jobs",
            "params": [
              {
                "name": "transformationId",
                "value": "",
                "type": "query",
                "description": "List only jobs for the specified transformation. The transformation is identified by ID."
              },
              {
                "name": "transformationExternalId",
                "value": "",
                "type": "query",
                "description": "List only jobs for the specified transformation. The transformation is identified by external ID."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned. The maximum is 1000, default limit is 100."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n"
        },
        {
          "info": {
            "name": "Retrieve jobs by ids",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/jobs/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nRetrieve a maximum of 1000 jobs by ids per request."
        },
        {
          "info": {
            "name": "List job metrics by job id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/jobs/:id/metrics",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The job id."
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n"
        }
      ]
    }
  ],
  "bundled": true
}
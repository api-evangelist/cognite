{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Postgres Gateway Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Postgres Gateway Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/postgresgateway",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results to be returned. The maximum results returned by the server is 100 even if you specify a higher limit."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for paging through results. In general, if a response contains a `nextCursor`\nproperty, it means that there may be more results, and you should pass that value as the\n`cursor` parameter in the next request.\n\nNote that the cursor may or may not be encrypted, but either way, it is not intended to be\ndecoded. Its internal structure is not a part of the public API, and may change without\nnotice. You should treat it as an opaque string and not attempt to craft your own cursors.\n"
              }
            ]
          },
          "docs": "\n\n> **Required capabilities:** `postgresGateway:READ`\n\nList all users in a given project. If more than `limit` users exist, a cursor for pagination will be returned with the response."
        },
        {
          "info": {
            "name": "Create users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/postgresgateway",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `postgresGateway:WRITE`\n\nCreate postgres users."
        },
        {
          "info": {
            "name": "Filter users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/postgresgateway/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List all postgres users for a given project. If more than `limit` users exist, a cursor for pagination will be returned with the response."
        },
        {
          "info": {
            "name": "Retrieve users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/postgresgateway/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `postgresGateway:READ`\n\nRetreive a list of postgres users by their usernames, optionally ignoring unknown usernames"
        },
        {
          "info": {
            "name": "Update users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/postgresgateway/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `[object Object]`\n\nUpdate postgres users"
        },
        {
          "info": {
            "name": "Delete users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/postgresgateway/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `[object Object]`\n\nDelete postgres users"
        }
      ]
    }
  ],
  "bundled": true
}
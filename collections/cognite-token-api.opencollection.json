{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Token API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Inspect",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/token/inspect"
          },
          "docs": "\n\n> **Required capabilities:** `projectsAcl:LIST` `groupsAcl:LIST`\n\nInspect CDF access granted to an IdP issued token"
        }
      ]
    }
  ],
  "bundled": true
}
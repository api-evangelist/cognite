{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Labels API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Labels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create label definitions.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/labels",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `labelsAcl:WRITE`\n\nCreates label definitions that can be used across different resource types. The label definitions are uniquely identified by their external id."
        },
        {
          "info": {
            "name": "Filter labels",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/labels/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `labelsAcl:READ`\n\nUse advanced filtering options to find label definitions."
        },
        {
          "info": {
            "name": "Retrieve labels",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/labels/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `labelsAcl:READ`\n\nRetrieve labels using their external ids"
        },
        {
          "info": {
            "name": "Delete label definitions.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/labels/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `labelsAcl:WRITE`\n\nDelete all the label definitions specified by their external ids. The resource items that have the corresponding label attached remain unmodified. It is up to the client to clean up the resource items from their attached labels if necessary."
        }
      ]
    }
  ],
  "bundled": true
}
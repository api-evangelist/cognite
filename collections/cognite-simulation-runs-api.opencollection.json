{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Simulation Runs API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Simulation Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run Simulation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/run",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Request to run a simulator routine asynchronously.\n\nThe total size of the request body can be a maximum of 50.00 KB."
        },
        {
          "info": {
            "name": "Filter Simulation Runs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/runs/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of simulation runs that match the given criteria."
        },
        {
          "info": {
            "name": "Retrieve Simulation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/runs/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve a simulation run by ID."
        },
        {
          "info": {
            "name": "Retrieve Simulation Data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/simulators/runs/data/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve data associated with a simulation run by ID."
        }
      ]
    }
  ],
  "bundled": true
}
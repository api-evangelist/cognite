{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Data sets API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data sets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create data sets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/datasets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datasetsAcl:WRITE`\n\nYou can create a maximum of 10 data sets per request."
        },
        {
          "info": {
            "name": "Filter data sets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/datasets/list",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datasetsAcl:READ`\n\nUse advanced filtering options to find data sets."
        },
        {
          "info": {
            "name": "Aggregate data sets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/datasets/aggregate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datasetsAcl:READ`\n\nAggregate data sets in the same project. Criteria can be applied to select a subset of data sets."
        },
        {
          "info": {
            "name": "Retrieve data sets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/datasets/byids",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datasetsAcl:READ`\n\nRetrieve data sets by IDs or external IDs."
        },
        {
          "info": {
            "name": "Update data sets.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/datasets/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `datasetsAcl:WRITE`\n"
        }
      ]
    }
  ],
  "bundled": true
}
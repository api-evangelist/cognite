{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Unit Systems API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Unit Systems",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all unit systems",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/units/systems"
          },
          "docs": "List all unit systems."
        }
      ]
    }
  ],
  "bundled": true
}
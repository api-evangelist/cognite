{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognite 3D Asset Mapping Query API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Query",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{cluster}.cognitedata.com/api/v1/projects/{project}/transformations/query/run",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\n> **Required capabilities:** `transformationsAcl:READ`\n\nPreview a SQL query."
        }
      ]
    }
  ],
  "bundled": true
}